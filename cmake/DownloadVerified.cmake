# 통신 실패만 호출자에게 돌려준다. 받은 파일의 해시 불일치는 즉시 설정 실패다.
function(pa_download_verified url destination sha256 result)
  if(EXISTS "${destination}")
    file(SHA256 "${destination}" actual)
    if(actual STREQUAL sha256)
      set(${result} TRUE PARENT_SCOPE)
      return()
    endif()
    file(REMOVE "${destination}")
  endif()
  file(DOWNLOAD "${url}" "${destination}" STATUS status
    TLS_VERIFY ON TIMEOUT 180 INACTIVITY_TIMEOUT 30)
  list(GET status 0 code)
  if(NOT code EQUAL 0)
    file(REMOVE "${destination}")
    set(${result} FALSE PARENT_SCOPE)
    return()
  endif()
  file(SHA256 "${destination}" actual)
  if(NOT actual STREQUAL sha256)
    file(REMOVE "${destination}")
    message(FATAL_ERROR "내려받은 파일의 SHA-256이 다르다")
  endif()
  set(${result} TRUE PARENT_SCOPE)
endfunction()
