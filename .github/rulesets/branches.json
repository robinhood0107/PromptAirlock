{
  "name": "branch-names",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": [
        "refs/heads/main", "refs/heads/feature/*", "refs/heads/fix/*",
        "refs/heads/docs/*", "refs/heads/chore/*", "refs/heads/spike/*"
      ]
    }
  },
  "rules": [
    { "type": "creation" }
  ]
}
